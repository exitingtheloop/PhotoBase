{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PhotoBaseDb": "Server=(localdb)\\mssqllocaldb;Database=PhotoBase;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "SecretKey": "CHANGE-ME-IN-PRODUCTION-USE-ENV-VAR-OR-KEYVAULT-32CHARS-MIN!!",
    "Issuer": "PhotoBase",
    "Audience": "PhotoBase",
    "ExpiresInMinutes": 480
  },
  "Storage": {
    "BasePath": "./data",
    "OriginalsFolder": "originals",
    "ThumbsFolder": "thumbs"
  },
  "Upload": {
    "MaxFileSizeBytes": 52428800,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".tif", ".tiff", ".bmp", ".webp" ]
  }
}
