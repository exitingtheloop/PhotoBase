@page "/"

<PageTitle>PhotoBase — Plant Photo &amp; Asset Bank</PageTitle>

<!-- SECTION 1: Intro -->
<section class="usa-section">
    <div class="grid-container">
        <h1 class="font-heading-xl margin-top-0">PhotoBase</h1>
        <hr class="border-base-light" />
<p class="usa-intro">
    A secure, internal-first photo and asset bank for plant collections.
            Browse thumbnails and metadata publicly, or log in to download original
   high-resolution images.
        </p>
    </div>
</section>

<!-- SECTION 2: Hero -->
<section class="usa-hero" aria-label="PhotoBase Introduction">
    <div class="grid-container">
        <div class="usa-hero__callout">
         <h1 class="usa-hero__heading" tabindex="-1">
            <span class="usa-hero__heading--alt">PhotoBase:</span>
   Plant Collection Photography
            </h1>
 <p>
            Search across accession numbers, plant names, locations, and keywords.
                View thumbnails and metadata instantly — no account required.
            </p>
    <a class="usa-button" href="/gallery">Browse the Gallery</a>
    </div>
    </div>
</section>

<!-- SECTION 3: Features -->
<section class="usa-graphic-list usa-section usa-section--dark">
    <div class="grid-container">
        <div class="usa-graphic-list__row grid-row grid-gap">
         <div class="usa-media-block tablet:grid-col">
  <img class="usa-media-block__img"
          src="/uswds-custom/img/circle-124.png"
        alt="" />
      <div class="usa-media-block__body">
 <h2 class="usa-graphic-list__heading">
     Public Search &amp; Browse
     </h2>
            <p>
           Anyone can search across plant names, accession numbers,
          keywords, locations, and categories — no login required.
       View thumbnails and full metadata for every record.
        </p>
              </div>
            </div>
<div class="usa-media-block tablet:grid-col">
                <img class="usa-media-block__img"
      src="/uswds-custom/img/circle-124.png"
          alt="" />
  <div class="usa-media-block__body">
          <h2 class="usa-graphic-list__heading">
      Secure Original Downloads
     </h2>
     <p>
     Authenticated internal users can download full-resolution
     originals. Public visitors see thumbnails only — originals
        are never exposed without authorization.
               </p>
     </div>
            </div>
        </div>
        <div class="usa-graphic-list__row grid-row grid-gap">
            <div class="usa-media-block tablet:grid-col">
       <img class="usa-media-block__img"
           src="/uswds-custom/img/circle-124.png"
              alt="" />
            <div class="usa-media-block__body">
          <h2 class="usa-graphic-list__heading">
   TSV Plant Record Import
  </h2>
   <p>
        Administrators can upload tab-separated files to import or
         update plant records in bulk, keyed by accession number.
         Clear validation feedback on every import.
          </p>
           </div>
   </div>
            <div class="usa-media-block tablet:grid-col">
           <img class="usa-media-block__img"
         src="/uswds-custom/img/circle-124.png"
                   alt="" />
       <div class="usa-media-block__body">
           <h2 class="usa-graphic-list__heading">
         Duplicate Detection
                </h2>
        <p>
      Every upload is hashed with SHA-256. If an identical file
      already exists in the system, the upload is blocked to
            prevent accidental duplicates.
        </p>
                </div>
        </div>
        </div>
    </div>
</section>

<!-- SECTION 4: How it works -->
<section class="usa-section">
    <div class="grid-container">
        <div class="grid-row grid-gap">
   <div class="tablet:grid-col-4">
                <h2 class="font-heading-xl margin-top-0 tablet:margin-bottom-0">
 How PhotoBase works
       </h2>
      </div>
       <div class="tablet:grid-col-8 usa-prose">
  <p>
    PhotoBase stores high-resolution plant photography alongside
               accession-based metadata imported from your existing plant records.
          When an image is uploaded with an accession number, known fields
     are auto-filled from the plant record database.
         </p>
       <p>
 Thumbnails are generated automatically on upload and served
                publicly for fast browsing. Original files are stored securely
    and only accessible to authenticated users through a gated
        download endpoint.
           </p>
  </div>
     </div>
    </div>
</section>

<!-- SECTION 5: Call to action -->
<section class="usa-section usa-section--light">
    <div class="grid-container">
        <h2 class="font-heading-xl margin-y-0">Get started</h2>
        <p class="usa-intro">
    Search the collection publicly, or log in to access downloads and
      admin tools.
        </p>
        <div class="margin-top-2">
      <a class="usa-button usa-button--big" href="/gallery">Browse Gallery</a>
            <a class="usa-button usa-button--big usa-button--outline" href="/login">Log In</a>
      </div>
    </div>
</section>

