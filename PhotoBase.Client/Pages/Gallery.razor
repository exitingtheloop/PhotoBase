@page "/gallery"
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>Gallery — PhotoBase</PageTitle>

<section class="usa-section">
    <div class="grid-container">
        <h1 class="font-heading-xl margin-top-0">Gallery</h1>

        <!-- Search bar -->
        <div class="margin-bottom-3">
            <div class="display-flex flex-align-end grid-gap-1">
                <div class="flex-fill">
                    <UsaSearch Size="big"
                               InputId="gallery-search"
                               Placeholder="Search by plant name, accession, keyword, location…"
                               AriaLabel="Search the gallery"
                               Label="Search the gallery"
                               SearchTerm="@_query"
                               SearchTermChanged="val => _query = val"
                               OnSearch="HandleSearch" />
                </div>
            </div>
        </div>

        <!-- Active filter chips -->
        <ActiveFilters Query="@_query"
                       Category="@_category"
                       Location="@_location"
                       Photographer="@_photographer"
                       Year="@_year"
                       OnClearQuery="() => ClearFilter(nameof(_query))"
                       OnClearCategory="() => ClearFilter(nameof(_category))"
                       OnClearLocation="() => ClearFilter(nameof(_location))"
                       OnClearPhotographer="() => ClearFilter(nameof(_photographer))"
                       OnClearYear="() => ClearFilter(nameof(_year))"
                       OnClearAll="ClearAllFilters" />

        <!-- Main layout: sidebar + results -->
        <div class="grid-row grid-gap-4">

            <!-- Filter sidebar -->
            <aside class="desktop:grid-col-3">
                @if (_facets is not null)
                {
                    <FilterSidebar Facets="_facets"
                                   SelectedCategory="@_category"
                                   SelectedLocation="@_location"
                                   SelectedPhotographer="@_photographer"
                                   SelectedYear="@_year"
                                   SelectedCategoryChanged="val => { _category = val; }"
                                   SelectedLocationChanged="val => { _location = val; }"
                                   SelectedPhotographerChanged="val => { _photographer = val; }"
                                   SelectedYearChanged="val => { _year = val; }"
                                   OnFiltersChanged="HandleFiltersChanged" />
                }
            </aside>

            <!-- Results -->
            <div class="desktop:grid-col-9">

                @if (_loading)
                {
                    <UsaSpinner Message="Searching the collection…" />
                }
                else if (_error is not null)
                {
                    <UsaAlert Type="error" Heading="Something went wrong">
                        @_error
                    </UsaAlert>
                    <button class="usa-button usa-button--outline margin-top-2" @onclick="RetryLoad">
                        Try again
                    </button>
                }
                else if (_result is not null && _result.Items.Count == 0)
                {
                    <UsaAlert Type="info" Heading="No results">
                        @if (!HasAnyFilter)
                        {
                            <span>The gallery is empty. Upload some images to get started.</span>
                        }
                        else
                        {
                            <span>No assets match the current filters. Try removing some filters.</span>
                        }
                    </UsaAlert>
                }
                else if (_result is not null)
                {
                    <!-- Result count + sort -->
                    <div class="display-flex flex-justify flex-align-center margin-bottom-2">
                        <p class="text-base margin-0">
                            Showing @((_result.Page - 1) * _result.PageSize + 1)–@(Math.Min(_result.Page * _result.PageSize, _result.TotalCount))
                            of @_result.TotalCount results
                        </p>
                        <SortDropdown Value="@_sort" ValueChanged="HandleSortChanged" />
                    </div>

                    <!-- Card grid -->
                    <ul class="usa-card-group">
                        @foreach (var asset in _result.Items)
                        {
                            <li class="usa-card tablet:grid-col-4 margin-bottom-3">
                                <div class="usa-card__container">
                                    <div class="usa-card__media">
                                        <div class="usa-card__img">
                                            <a href="/gallery/@asset.Id" aria-label="View @asset.Title">
                                                <img src="@asset.ThumbUrl"
                                                     alt="@asset.Title"
                                                     loading="lazy"
                                                     onerror="this.onerror=null;this.src='/uswds-custom/img/circle-124.png';"
                                                     style="width:100%; height:200px; object-fit:cover;" />
                                            </a>
                                        </div>
                                    </div>
                                    <div class="usa-card__body">
                                        <h3 class="usa-card__heading">
                                            <a href="/gallery/@asset.Id" class="usa-link">
                                                @asset.Title
                                            </a>
                                        </h3>
                                        @if (!string.IsNullOrEmpty(asset.PlantName))
                                        {
                                            <p class="margin-top-05 margin-bottom-05">
                                                <strong>@asset.PlantName</strong>
                                            </p>
                                        }
                                        @if (!string.IsNullOrEmpty(asset.AccessionNumber))
                                        {
                                            <p class="text-base margin-top-0 margin-bottom-0">
                                                Accession: @asset.AccessionNumber
                                            </p>
                                        }
                                        @if (!string.IsNullOrEmpty(asset.Location))
                                        {
                                            <p class="text-base margin-top-0">@asset.Location</p>
                                        }
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>

                    <!-- Pagination -->
                    <UsaPagination CurrentPage="_result.Page"
                                   TotalPages="_result.TotalPages"
                                   OnPageChanged="HandlePageChanged" />
                }
            </div>
        </div>
    </div>
</section>

@code {
    // State
    private string _query = "";
    private string? _category;
    private string? _location;
    private string? _photographer;
    private int? _year;
    private string _sort = "newest";
    private int _page = 1;
    private const int PageSize = 12;

    private PagedResult<AssetListItemDto>? _result;
    private FacetsDto? _facets;
    private bool _loading;
    private string? _error;

    private bool HasAnyFilter =>
        !string.IsNullOrWhiteSpace(_query) || _category is not null ||
        _location is not null || _photographer is not null || _year is not null;

    protected override async Task OnInitializedAsync()
    {
        // Restore state from URL query params
        var uri = new Uri(Nav.Uri);
        var qs = System.Web.HttpUtility.ParseQueryString(uri.Query);
        _query = qs["query"] ?? "";
        _category = qs["category"];
        _location = qs["location"];
        _photographer = qs["photographer"];
        _sort = qs["sort"] ?? "newest";
        if (int.TryParse(qs["year"], out var y)) _year = y;
        if (int.TryParse(qs["page"], out var p) && p > 0) _page = p;

        // Load facets + results in parallel
        await Task.WhenAll(LoadFacetsAsync(), LoadAsync());
    }

    // ?? Search ??????????????????????????????????????????

    private async Task HandleSearch(string term)
    {
        _query = term;
        _page = 1;
        UpdateUrl();
        await LoadAsync();
    }

    // ?? Filters ?????????????????????????????????????????

    private async Task HandleFiltersChanged()
    {
        _page = 1;
        UpdateUrl();
        await LoadAsync();
    }

    private async Task ClearFilter(string which)
    {
        switch (which)
        {
            case nameof(_query): _query = ""; break;
            case nameof(_category): _category = null; break;
            case nameof(_location): _location = null; break;
            case nameof(_photographer): _photographer = null; break;
            case nameof(_year): _year = null; break;
        }
        _page = 1;
        UpdateUrl();
        await LoadAsync();
    }

    private async Task ClearAllFilters()
    {
        _query = "";
        _category = null;
        _location = null;
        _photographer = null;
        _year = null;
        _page = 1;
        UpdateUrl();
        await LoadAsync();
    }

    // ?? Sort ????????????????????????????????????????????

    private async Task HandleSortChanged(string value)
    {
        _sort = value;
        _page = 1;
        UpdateUrl();
        await LoadAsync();
    }

    // ?? Pagination ??????????????????????????????????????

    private async Task HandlePageChanged(int page)
    {
        _page = page;
        UpdateUrl();
        await LoadAsync();
    }

    private async Task RetryLoad() => await LoadAsync();

    // ?? Data loading ????????????????????????????????????

    private async Task LoadFacetsAsync()
    {
        try
        {
            _facets = await Api.GetFacetsAsync();
        }
        catch
        {
            _facets = new FacetsDto();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            _result = await Api.SearchAssetsAsync(
                   query: string.IsNullOrWhiteSpace(_query) ? null : _query,
                 page: _page,
                pageSize: PageSize,
                   category: _category,
                  location: _location,
           photographer: _photographer,
                   year: _year,
                     sort: _sort);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    // ?? URL sync ????????????????????????????????????????

    private void UpdateUrl()
    {
        var url = "/gallery";
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(_query))
            parts.Add($"query={Uri.EscapeDataString(_query)}");
        if (_category is not null)
            parts.Add($"category={Uri.EscapeDataString(_category)}");
        if (_location is not null)
            parts.Add($"location={Uri.EscapeDataString(_location)}");
        if (_photographer is not null)
            parts.Add($"photographer={Uri.EscapeDataString(_photographer)}");
        if (_year.HasValue)
            parts.Add($"year={_year.Value}");
        if (_sort != "newest")
            parts.Add($"sort={Uri.EscapeDataString(_sort)}");
        if (_page > 1)
            parts.Add($"page={_page}");
        if (parts.Count > 0)
            url += "?" + string.Join("&", parts);

        Nav.NavigateTo(url, replace: true);
    }
}
