@* USWDS Button — https://designsystem.digital.gov/components/button/ *@

<button type="@ButtonType"
        class="usa-button @VariantClass @(Disabled ? "usa-button--disabled" : "")"
        disabled="@Disabled"
        @onclick="OnClick">
    @ChildContent
</button>

@code {
    /// <summary>Button type attribute. Default: button.</summary>
    [Parameter] public string ButtonType { get; set; } = "button";

    /// <summary>Visual variant: default, secondary, accent-cool, accent-warm, outline, inverse, unstyled, big.</summary>
    [Parameter] public string Variant { get; set; } = "";

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public EventCallback<Microsoft.AspNetCore.Components.Web.MouseEventArgs> OnClick { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string VariantClass => Variant switch
    {
        "secondary" => "usa-button--secondary",
        "accent-cool" => "usa-button--accent-cool",
        "accent-warm" => "usa-button--accent-warm",
        "outline" => "usa-button--outline",
        "inverse" => "usa-button--outline usa-button--inverse",
        "unstyled" => "usa-button--unstyled",
        "big" => "usa-button--big",
        _ => ""
    };
}
